#!/usr/bin/env node
// qa-state: o Claude do QA (claude -p, qa.js) grava resultado de cenário, evidências e massa por aqui (~/.claude é bloqueada para Write).
// A pasta do QA vem em QA_DIR (o maestro passa). Uso:
//   qa-state cenario CT01 concluir --status passou|falhou|sem-massa --nota "o que foi visto"
//   qa-state evidencia CT01 <arquivo...>
//   qa-state massa add   (só na Etapa 4; recusado na execução do cenário)
//     --papel "pedido faturado" --cenarios CT01,CT02 --dados '{"NUMPEDIDO":1}' [--consulta "SELECT …"]
//   qa-state massa proposta --papel "…" --cenarios CT01 --dados '{…}' --sql "UPDATE … WHERE …;INSERT …" --desfazer "UPDATE … WHERE …" --porque "…"
//     (só na Etapa 4 e com banco liberado: o humano lê e aprova, a extensão executa; a IA nunca roda escrita)
//   qa-state massa M3 valida|consumida|invalida
//   qa-state pausa --motivo "<curto>" --pergunta "<o que falta>" [--opcoes "A|B"]   (falta informação que só o humano tem: pergunta e termina)
//   qa-state precondicao --status ok|falhou --nota "<o que foi confirmado ou o motivo>"   (só na Pré-condição: health check e login, antes da suíte)
//   qa-state analise <<'FIM' … FIM        (análise do ambiente que parou; texto pela entrada padrão)
//   qa-state status
const qa = require('./qa');
const dir = process.env.QA_DIR;
const [obj, a, b, ...resto] = process.argv.slice(2);
const opt = {};
for (let i = 0; i < process.argv.length; i++) if (process.argv[i].startsWith('--')) opt[process.argv[i].slice(2)] = process.argv[i + 1];
const sair = (msg, code = 1) => { console[code ? 'error' : 'log'](msg); process.exit(code); };
if (!dir) sair('qa-state: QA_DIR não definida (rode pelo ▶ do QA na Crafting Table)');
try {
  if (obj === 'cenario' && b === 'concluir') { qa.concluirCenario(dir, a, opt.status, opt.nota || ''); sair(`${a}: ${opt.status}`, 0); }
  if (obj === 'evidencia') { sair(qa.evidencia(dir, a, [b, ...resto]).map((f) => `salvo: ${f}`).join('\n'), 0); }
  if (obj === 'massa' && a === 'proposta') {
    if (!qa.emEtapaMassa(dir)) sair('qa-state: massa proposta só vale na Etapa 4 (Massa de dados)');
    if (process.env.QA_BANCO_ESCRITA !== '1') sair('qa-state: a alteração de massa por SQL não está liberada (banco não configurado ou em produção): registre como pendência');
    let dados = {};
    try { dados = JSON.parse(opt.dados || '{}'); } catch { sair('qa-state: --dados precisa ser JSON'); }
    qa.proporMassa(dir, { papel: opt.papel, cenarios: String(opt.cenarios || '').split(',').map((x) => x.trim()).filter(Boolean), dados, sql: opt.sql, desfazer: opt.desfazer, porque: opt.porque });
    sair('proposta registrada: o humano vai ler e aprovar. Termine agora, sem executar nada', 0);
  }
  if (obj === 'massa' && a === 'add') {
    if (!qa.emEtapaMassa(dir)) sair('qa-state: massa add só vale na Etapa 4 (Massa de dados). Na execução do cenário use só a massa recebida: se ela não serve, massa <ID> invalida e cenario <CT> concluir --status sem-massa');
    let dados = {};
    try { dados = JSON.parse(opt.dados || '{}'); } catch { sair('qa-state: --dados precisa ser JSON'); }
    sair(qa.massaAdd(dir, { papel: opt.papel, cenarios: String(opt.cenarios || '').split(',').map((x) => x.trim()).filter(Boolean), dados, consulta: opt.consulta }), 0);
  }
  if (obj === 'massa' && a) { qa.massaEstado(dir, a, b); sair(`${a}: ${b}`, 0); }
  if (obj === 'pausa') {
    if (!qa.emEtapaMassa(dir) && !qa.cenarios(dir).cenarios.some((c) => c.status === 'executando')) sair('qa-state: pausa só vale na massa ou com um cenário em execução');
    qa.registrarPausa(dir, { motivo: opt.motivo || '', pergunta: opt.pergunta, opcoes: String(opt.opcoes || '').split('|').map((x) => x.trim()).filter(Boolean) });
    sair('pergunta registrada: termine agora, sem concluir o cenário', 0);
  }
  if (obj === 'precondicao') {
    if (!qa.emPreCondicao(dir)) sair('qa-state: precondicao só vale na Pré-condição (antes da suíte)');
    qa.registrarPreCondicao(dir, opt.status, opt.nota);
    sair(`pré-condição: ${opt.status}. Termine agora`, 0);
  }
  if (obj === 'analise') { qa.gravarAnalise(dir, [a, b, ...resto].filter(Boolean).join(' ') || require('fs').readFileSync(0, 'utf8')); sair('análise gravada', 0); }
  if (obj === 'status') sair(JSON.stringify({ cenarios: qa.cenarios(dir).cenarios.map(({ id, titulo, status }) => ({ id, titulo, status })), massa: qa.massa(dir).itens }, null, 2), 0);
  sair('qa-state: comando desconhecido. Veja o topo de qa/qa-state.');
} catch (e) { sair(`qa-state: ${e.message}`); }
