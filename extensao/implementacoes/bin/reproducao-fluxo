#!/usr/bin/env node
// reproducao-fluxo: o Claude da etapa Reprodução da esteira de Implementação registra os cenários e o andamento por aqui.
// A pasta da aba vem em IMPLEMENTACAO_DIR (a extensão passa). Mesmo registro do fluxo dos Incidentes (componentes/fluxo-passos.js). Uso:
//   reproducao-fluxo plano <<'FIM' [{"titulo":"Abrir o módulo Separação","texto":"o que fazer e o que esperar"}, …] FIM
//   reproducao-fluxo iniciar P01
//   reproducao-fluxo acao P01 "<comando exato que repete o passo>"
//   reproducao-fluxo evidencia P01 /tmp/print.png   (origem: /tmp ou a pasta da aba, ex.: evidencias-ticket/KAN-1-print.png)
//   reproducao-fluxo concluir P01 passou|falhou|bloqueado --nota "o que foi visto"   (falhou = o erro aconteceu)
//   reproducao-fluxo status
const fluxo = require('../../componentes/fluxo-passos');
const dir = process.env.IMPLEMENTACAO_DIR;
const [cmd, id, ...resto] = process.argv.slice(2);
const sair = (msg, code = 1) => {
  console[code ? 'error' : 'log'](msg);
  process.exit(code);
};
if (!dir) sair('reproducao-fluxo: IMPLEMENTACAO_DIR não definida (rode pela esteira da Crafting Table)');
try {
  if (cmd === 'plano') {
    let l;
    try {
      l = JSON.parse(require('fs').readFileSync(0, 'utf8'));
    } catch {
      sair('reproducao-fluxo: o plano precisa ser JSON pela entrada padrão');
    }
    fluxo.plano(dir, l);
    sair(`plano criado: ${fluxo.ler(dir).passos.length} cenários`, 0);
  }
  if (cmd === 'iniciar') {
    fluxo.iniciar(dir, id);
    sair(`${id}: executando`, 0);
  }
  if (cmd === 'acao') {
    fluxo.acao(dir, id, resto.join(' '));
    sair(`${id}: ação registrada`, 0);
  }
  if (cmd === 'evidencia')
    sair(
      fluxo
        .evidencia(dir, id, resto)
        .map((f) => `salvo: ${f}`)
        .join('\n'),
      0
    );
  if (cmd === 'concluir') {
    const i = resto.indexOf('--nota');
    fluxo.concluir(dir, id, resto[0], i >= 0 ? resto.slice(i + 1).join(' ') : '');
    sair(`${id}: ${resto[0]}`, 0);
  }
  if (cmd === 'status') sair(fluxo.estadoParaPrompt(dir) || '(sem fluxo)', 0);
  sair('reproducao-fluxo: comando desconhecido. Veja o topo de implementacoes/bin/reproducao-fluxo.');
} catch (e) {
  sair(`reproducao-fluxo: ${e.message}`);
}
