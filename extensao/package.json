{
  "name": "claude-abas",
  "displayName": "Crafting Table",
  "description": "Bancada de trabalho ao lado do Claude Code: notas, tickets do Jira, documentos da conversa, comandos, evidências e emuladores Android, tudo em abas no mesmo painel.",
  "icon": "icons/crafting-table.png",
  "publisher": "local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "craftingTable",
          "title": "Crafting Table",
          "icon": "icons/crafting-table.png"
        },
        {
          "id": "claudeAbas-tickets",
          "title": "Tickets",
          "icon": "icons/crafting-table.png"
        },
        {
          "id": "claudeAbas-musica",
          "title": "YouTube Music",
          "icon": "icons/musica.svg"
        }
      ]
    },
    "views": {
      "craftingTable": [
        {
          "type": "webview",
          "id": "craftingTable.vazio",
          "name": "Crafting Table",
          "when": "false"
        }
      ],
      "claudeAbas-musica": [
        {
          "type": "webview",
          "id": "claudeAbas.musica",
          "name": "YouTube Music"
        }
      ],
      "claudeAbas-tickets": [
        {
          "type": "webview",
          "id": "claudeAbas.tickets",
          "name": "Tickets"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeAbas.abrirClaude",
        "title": "Claude",
        "icon": {
          "light": "icons/menu/claude-light.svg",
          "dark": "icons/menu/claude-dark.svg"
        }
      },
      {
        "command": "claudeAbas.abrirTeams",
        "title": "Teams",
        "icon": {
          "light": "icons/menu/teams-light.svg",
          "dark": "icons/menu/teams-dark.svg"
        }
      },
      {
        "command": "claudeAbas.abrirTickets",
        "title": "Tickets",
        "icon": {
          "light": "icons/menu/ticket-light.svg",
          "dark": "icons/menu/ticket-dark.svg"
        }
      },
      {
        "command": "claudeAbas.musica.voltar",
        "title": "Voltar",
        "icon": "$(arrow-left)"
      },
      {
        "command": "claudeAbas.musica.recarregar",
        "title": "Recarregar",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeAbas.musica.inicio",
        "title": "Início do YouTube Music",
        "icon": "$(home)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeAbas.musica.voltar",
          "when": "view == claudeAbas.musica",
          "group": "navigation@1"
        },
        {
          "command": "claudeAbas.musica.recarregar",
          "when": "view == claudeAbas.musica",
          "group": "navigation@2"
        },
        {
          "command": "claudeAbas.musica.inicio",
          "when": "view == claudeAbas.musica",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Crafting Table",
      "properties": {
        "craftingTable.avdPadrao": {
          "type": "string",
          "default": "Small_Phone",
          "description": "Emulador que a Crafting Table liga quando a skill testes-funcionais precisa de um e nenhum aparelho está conectado."
        },
        "craftingTable.specsDir": {
          "type": "string",
          "default": "",
          "description": "Repositório git das specs SDD dos tickets (▶ do ticket cria <CHAVE>-<slug>/ nele). Vazio: ~/specs."
        }
      }
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1"
  }
}
