{
  "name": "claude-abas",
  "displayName": "Crafting Table",
  "description": "Bancada de trabalho ao lado do Claude Code: notas, tickets do Jira, documentos da conversa, comandos, evidências e emuladores Android, tudo em abas no mesmo painel.",
  "icon": "icons/crafting-table.png",
  "publisher": "local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "markdown.previewStyles": [
      "./markdown.css"
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "craftingTable",
          "title": "Crafting Table",
          "icon": "icons/crafting-table.png"
        },
        {
          "id": "claudeAbas-tickets",
          "title": "Crafting Table",
          "icon": "icons/crafting-table.png"
        }
      ]
    },
    "views": {
      "craftingTable": [
        {
          "type": "webview",
          "id": "craftingTable.vazio",
          "name": "Crafting Table",
          "when": "false"
        }
      ],
      "claudeAbas-tickets": [
        {
          "type": "webview",
          "id": "claudeAbas.tickets",
          "name": "Crafting Table"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeAbas.abrirClaude",
        "title": "Claude",
        "icon": {
          "light": "icons/menu/claude-light.svg",
          "dark": "icons/menu/claude-dark.svg"
        }
      },
      {
        "command": "claudeAbas.testarTeams",
        "title": "Crafting Table: Testar aviso para o Teams"
      },
      {
        "command": "claudeAbas.abrirTeams",
        "title": "Teams",
        "icon": {
          "light": "icons/menu/teams-light.svg",
          "dark": "icons/menu/teams-dark.svg"
        }
      },
      {
        "command": "claudeAbas.abrirTickets",
        "title": "Tickets",
        "icon": {
          "light": "icons/menu/ticket-light.svg",
          "dark": "icons/menu/ticket-dark.svg"
        }
      },
      {
        "command": "claudeAbas.configuracoes",
        "title": "Configurações",
        "icon": "$(gear)",
        "category": "Crafting Table"
      },
      {
        "command": "claudeAbas.telaCheia",
        "title": "Tela cheia",
        "icon": "$(screen-full)",
        "category": "Crafting Table"
      },
      {
        "command": "claudeAbas.sairTelaCheia",
        "title": "Sair da tela cheia",
        "icon": "$(screen-normal)",
        "category": "Crafting Table"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeAbas.configuracoes",
          "when": "view == claudeAbas.tickets",
          "group": "navigation@9"
        },
        {
          "command": "claudeAbas.telaCheia",
          "when": "view == claudeAbas.tickets",
          "group": "navigation@8"
        }
      ],
      "editor/title": [
        {
          "command": "claudeAbas.configuracoes",
          "when": "activeWebviewPanelId == 'claudeAbas.cheia'",
          "group": "navigation@1"
        },
        {
          "command": "claudeAbas.sairTelaCheia",
          "when": "activeWebviewPanelId == 'claudeAbas.cheia'",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Crafting Table",
      "properties": {
        "craftingTable.avdPadrao": {
          "type": "string",
          "default": "Small_Phone",
          "description": "Emulador que a Crafting Table liga quando a skill testes-funcionais precisa de um e nenhum aparelho está conectado."
        },
        "craftingTable.specsDir": {
          "type": "string",
          "default": "",
          "description": "Repositório git das specs SDD dos tickets (▶ do ticket cria <CHAVE>-<slug>/ nele). Vazio: ~/specs."
        },
        "craftingTable.agente": {
          "type": "string",
          "enum": [
            "claude"
          ],
          "default": "claude",
          "description": "Agente de IA do modo refinamento (por enquanto só Claude Code)."
        },
        "craftingTable.modelo": {
          "type": "string",
          "default": "",
          "description": "Modelo do Claude no modo refinamento (alias como opus, sonnet, fable ou o nome completo). Vazio: o do ~/.claude/settings.json."
        },
        "craftingTable.esforco": {
          "type": "string",
          "enum": ["", "low", "medium", "high", "xhigh", "max"],
          "default": "",
          "description": "Esforço (effort) do Claude no modo refinamento. Vazio: o do ~/.claude/settings.json."
        },
        "craftingTable.jiraSite": {
          "type": "string",
          "default": "",
          "description": "Site do Jira (https://<org>.atlassian.net). Vazio: o site do primeiro ticket da lista."
        },
        "craftingTable.jiraProjeto": {
          "type": "string",
          "default": "",
          "description": "Chave do projeto no Jira (ex.: WMS). Vazio: a do primeiro ticket da lista."
        },
        "craftingTable.jiraBoard": {
          "type": "string",
          "default": "Downstream",
          "description": "Board principal do projeto: as colunas dele viram as etapas do filtro dos vinculados (procura pelo nome)."
        },
        "craftingTable.etapasExtras": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Pronto p/ Dev"
          ],
          "description": "Status que não são coluna do board mas entram no filtro de etapas."
        },
        "craftingTable.specsRemoto": {
          "type": "string",
          "default": "",
          "description": "URL do repositório (GitLab) das specs, para clonar/atualizar a pasta de specs."
        },
        "craftingTable.repositorios": {
          "type": "array",
          "default": [],
          "description": "Repositórios de código que o Claude pode ler no refinamento: [{ caminho, camada (backend|mobile|web|outro), refRelease? }]. Vazio: novo-wms-backend e wms-mobile ao lado da pasta de specs.",
          "items": {
            "type": "object",
            "properties": {
              "caminho": {
                "type": "string"
              },
              "camada": {
                "type": "string",
                "enum": [
                  "backend",
                  "mobile",
                  "web",
                  "outro"
                ]
              },
              "refRelease": {
                "type": "string"
              }
            }
          }
        },
        "craftingTable.bancoConexao": {
          "type": "string",
          "default": "",
          "description": "Conexão salva do SQLcl usada pelo mapeamento do passo 3 (só leitura). Vazio: sem banco."
        },
        "craftingTable.bancoAmbiente": {
          "type": "string",
          "enum": [
            "",
            "copia-producao",
            "qas",
            "producao"
          ],
          "default": "",
          "description": "O que a conexão é. 'producao' é recusada: o mapeamento só consulta a cópia de produção ou o QAS."
        },
        "craftingTable.bancoSqlcl": {
          "type": "string",
          "default": "",
          "description": "Caminho do executável do SQLcl. Vazio: procura em ~/sqlcl/bin/sql e no PATH."
        },
        "craftingTable.bancoColunasSensiveis": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "cpf",
            "cnpj",
            "rg",
            "email",
            "telefone",
            "fone",
            "celular",
            "endereco",
            "logradouro",
            "cep",
            "senha",
            "password",
            "token",
            "nascimento",
            "salario"
          ],
          "description": "Colunas pessoais cujo valor vira *** antes de a IA ver o resultado (casa pelo nome da coluna)."
        }
      }
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1"
  }
}
